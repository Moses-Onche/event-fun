# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventfun?schema=public"

# --- Auth.js / NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Google sign-in (optional; the button is hidden when these are empty) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (optional; without SMTP_HOST emails are printed to the server console) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="EventFun <no-reply@eventfun.example>"

# --- Seeded admin account (used by `npm run db:seed`) ---
ADMIN_EMAIL="admin@eventfun.example"
ADMIN_PASSWORD="change-me-too"
